<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>RMP ERP</title>

<link rel="stylesheet" href="style.css">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

</head>

<body>

<div class="container">

<!-- SIDEBAR -->

<aside class="sidebar">

<div class="logo-section">

<img src="assets/logo.png" alt="RMP Logo">

<h2>RMP INTERIOR</h2>

<p>Built with Vision.<br>Designed with Care.</p>

</div>

<ul class="menu">

<li>
<a href="#">
<i class="fas fa-chart-line"></i>
Dashboard
</a>
</li>

<li>
<a href="#customerSection">
<i class="fas fa-users"></i>
Customers
</a>
</li>

<li>
<a href="#projectSection">
<i class="fas fa-building"></i>
Projects
</a>
</li>

<li>
<a href="#">
<i class="fas fa-file-invoice"></i>
Quotations
</a>
</li>

<li>
<a href="#">
<i class="fas fa-wallet"></i>
Expenses
</a>
</li>

<li>
<a href="#">
<i class="fas fa-file-pdf"></i>
Reports
</a>
</li>

<li>
<a href="#">
<i class="fas fa-cog"></i>
Settings
</a>
</li>

</ul>

</aside>

<!-- MAIN CONTENT -->

<main class="main-content">

<header class="topbar">

<h1>RMP ERP Dashboard</h1>

<div class="company-info">

<span>📞 9080405311</span>

<span>📧 rmpinteriorwork@gmail.com</span>

</div>

</header>

<!-- DASHBOARD CARDS -->

<section class="stats-grid">

<div class="stat-card">

<h3>Customers</h3>

<p id="totalCustomers">0</p>

</div>

<div class="stat-card">

<h3>Projects</h3>

<p id="activeProjects">0</p>

</div>

<div class="stat-card">

<h3>Quotations</h3>

<p id="pendingQuotes">0</p>

</div>

<div class="stat-card">

<h3>Expenses</h3>

<p id="totalExpenses">₹0</p>

</div>

</section>

<!-- CUSTOMER SECTION -->

<section
class="module-section"
id="customerSection">

<div class="section-title">

<h2>Customer Management</h2>

</div>

<div class="form-grid">

<input
type="text"
id="customerName"
placeholder="Customer Name">

<input
type="text"
id="customerPhone"
placeholder="Mobile Number">

<input
type="text"
id="customerAddress"
placeholder="Address">

<button
onclick="addCustomer()">

Add Customer

</button>

</div>

<input
type="text"
id="customerSearch"
placeholder="Search Customer"
onkeyup="searchCustomers()">

<div
id="customerCards"
class="customer-grid">

</div>

</section>

<!-- PROJECT SECTION -->

<section
class="module-section"
id="projectSection">

<div class="section-title">

<h2>Project Management</h2>

</div>

<div class="form-grid">

<input
type="text"
id="projectName"
placeholder="Project Name">

<input
type="text"
id="clientName"
placeholder="Client Name">

<input
type="number"
id="projectBudget"
placeholder="Budget">

<button
onclick="addProject()">

Add Project

</button>

</div>

<table>

<thead>

<tr>

<th>Project</th>

<th>Client</th>

<th>Status</th>

<th>Budget</th>

<th>Action</th>

</tr>

</thead>

<tbody id="projectTable">

</tbody>

</table>

</section>

<!-- BACKUP SECTION -->

<section class="module-section">

<div class="section-title">

<h2>Database Backup</h2>

</div>

<div class="backup-buttons">

<button onclick="exportBackup()">

Export JSON Backup

</button>

<input
type="file"
id="restoreFile"
onchange="importBackup(event)">

</div>

</section>

</main>

</div>

<script src="app.js"></script>

</body>

</html>
